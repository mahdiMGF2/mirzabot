<Files ".installed">
    Require all denied
</Files>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^rewrite-check$ probe.php [L]
</IfModule>

Options -Indexes

<FilesMatch "^error_log$|\.log$|\.log\.[0-9]+$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
